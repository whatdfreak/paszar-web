# Salin ke .env lalu isi nilainya. JANGAN commit .env.

# Database (Supabase / PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# NextAuth — NEXTAUTH_SECRET: openssl rand -base64 48
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://domain-anda.com

# Penyimpanan gambar produk (Supabase Storage). WAJIB di hosting serverless.
# SUPABASE_SERVICE_KEY hanya untuk server — jangan beri prefix NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=

# Seed produksi (default: ditolak). Hanya set untuk inisialisasi pertama yang disengaja.
# ALLOW_PRODUCTION_SEED=true
